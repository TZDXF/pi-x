{
  "name": "pix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "tauri dev",
    "dev:desktop:remote": "npm run build && tauri dev --features remote-access",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests",
    "check": "npm run lint && npm run typecheck && npm run build && cd src-tauri && cargo check",
    "clean": "cd src-tauri && cargo clean",
    "tauri": "tauri",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:web": "node --test \"tests/*.test.mjs\"",
    "package": "tauri build --features remote-access",
    "package:debug": "tauri build --features remote-access --debug",
    "package:nsis": "tauri build --features remote-access --bundles nsis",
    "package:msi": "tauri build --features remote-access --bundles msi"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.47.0",
    "@rive-app/webgl2": "^2.42.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/node-toolbar": "^1.1.1",
    "@vueuse/core": "^15.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.107",
    "ansi-to-vue3": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "media-chrome": "^4.19.2",
    "motion-v": "^2.4.4",
    "nanoid": "^6.0.1",
    "pinia": "^4.0.3",
    "qrcode.vue": "^3.11.0",
    "reka-ui": "^2.10.4",
    "shadcn-vue": "^2.8.2",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.13",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.12",
    "vue-stick-to-bottom": "^1.0.0",
    "vue-stream-markdown": "^2.0.0-beta.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "element-source-dev": "^0.5.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
